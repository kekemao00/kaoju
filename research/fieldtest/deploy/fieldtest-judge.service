[Unit]
Description=fieldtest judge endpoint
After=network-online.target
Wants=network-online.target

[Service]
User=fieldtest
ExecStart=/usr/local/bin/fieldtest judge -c /etc/fieldtest/fieldtest.json
Restart=always
RestartSec=3
LimitNOFILE=65536
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/fieldtest

[Install]
WantedBy=multi-user.target
